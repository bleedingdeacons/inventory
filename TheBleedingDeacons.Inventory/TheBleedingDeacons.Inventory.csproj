<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The platform-free half of Inventory: the logger that can be rebuilt at
    runtime, the durable Better Stack sink it layers on, the holding buffer,
    flush-on-error and the crash handlers. Plain net10.0, so it runs under a
    test host and in a console app exactly as it does on a phone.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package Info -->
    <PackageId>Inventory</PackageId>
    <Version>0.1.1</Version>
    <Authors>The Bleeding Deacons</Authors>
    <Company>The Bleeding Deacons</Company>
    <Product>Inventory</Product>
    <Description>Durable logging to Better Stack for .NET apps that are often offline: every event is written to disk first and shipped later with its own timestamp, held until the app is told where to ship, flushed the moment something goes wrong, and rebuilt in place when the settings change.</Description>
    <PackageTags>serilog;logging;betterstack;durable;maui;inventory</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/bleedingdeacons/inventory</RepositoryUrl>
    <PackageProjectUrl>https://github.com/bleedingdeacons/inventory</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Build Settings -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Copyright>Don't take yourself too damn seriously</Copyright>

    <!-- As freedom-sharp: PDBs inside the assembly plus Source Link, so the
         one .nupkg is debuggable without a symbol server. -->
    <DebugType>embedded</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ben.Demystifier" Version="0.4.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Http" Version="9.2.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TheBleedingDeacons.Inventory.Tests" />
    <InternalsVisibleTo Include="TheBleedingDeacons.Inventory.Specs" />
  </ItemGroup>

</Project>
