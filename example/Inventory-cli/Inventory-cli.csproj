<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The proof that Inventory stands on its own: a console app that holds its
    logs until it is told where to ship, then ships them, and references
    nothing of this suite's but the core library.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>InventoryCli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TheBleedingDeacons.Inventory\TheBleedingDeacons.Inventory.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

</Project>
